# ==============================================================================
# Variabile de Mediu pentru Deploy în Coolify (docker-compose.coolify.yml)
# Copiați aceste variabile în Coolify -> Project -> Environment Variables.
# ==============================================================================

# --- Port mapat pe host pentru cloudflared ---
APP_BIND_HOST=127.0.0.1
APP_PORT=3015

# --- Baza de Date PostgreSQL (internă în rețeaua Docker, neexpusă pe host) ---
POSTGRES_USER=ssm_user
POSTGRES_DB=ssm_db
# Generați cu: openssl rand -hex 24 (folosiți doar litere și cifre)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# --- Cheie de semnare JWT / sesiuni ---
# Generați cu: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET_KEY_64_CHARS

# --- Inițializare Parole pe Roluri RBAC (doar la prima pornire a rolurilor lipsă) ---
# Autentificarea se face exclusiv pe Rol + Parolă (fără email sau username).
# Minim 6 caractere. Dacă este setată, se aplică rolurilor fără parolă dedicată.
# După primul deploy, parolele se pot schimba din interfață ("Schimbă Parola").
INIT_DEFAULT_PASSWORD=CHANGE_ME_INITIAL_PASSWORD

# Opțional: parole și denumiri afișate specifice per rol (suprascriu INIT_DEFAULT_PASSWORD)
INIT_ADMIN_NAME=Administrator
INIT_ADMIN_PASSWORD=

INIT_SSM_NAME=Specialist SSM
INIT_SSM_PASSWORD=

INIT_HR_NAME=Resurse Umane
INIT_HR_PASSWORD=

INIT_IGIENA_NAME=Inspector Igienă
INIT_IGIENA_PASSWORD=
